# ===========================================================================
# IqbalAI production environment — copy to .env.prod and fill in every <...>.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Generate secrets with:  openssl rand -hex 32
# IMPORTANT: keep passwords URL-safe (letters + digits only). They are embedded in
# DB_URL / REDIS_URL, and a raw @ : / # character there corrupts the connection URL.
# ===========================================================================

# Public address of this server. Everything browser-facing must use it — "localhost"
# in any NEXT_PUBLIC_* value means the user's own machine, not the server.
SERVER_HOST=69.28.84.37

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=iqbalai
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=iqbalai
# Must contain the same user/password/db as the three lines above.
DB_URL=postgresql+asyncpg://iqbalai:<POSTGRES_PASSWORD>@postgres:5432/iqbalai

# --- Redis ----------------------------------------------------------------
# The password appears twice on purpose: once for the server's --requirepass and
# once inside the URL the app + Celery connect with. They MUST match exactly.
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# --- MinIO ----------------------------------------------------------------
MINIO_ROOT_USER=iqbalai_minio
MINIO_ROOT_PASSWORD=<MINIO_PASSWORD>
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=iqbalai_minio
MINIO_SECRET_KEY=<MINIO_PASSWORD>
MINIO_BUCKET_PDFS=pdfs
MINIO_BUCKET_AUDIO=audio
MINIO_BUCKET_ML_MODELS=ml-models
MINIO_BUCKET_EXPORTS=exports

# --- Qdrant / embeddings / events -----------------------------------------
QDRANT_URL=http://qdrant:6333
EMBEDDING_PROVIDER=infinity
EMBEDDING_MODEL=
EMBEDDING_VECTOR_DIM=0
INFINITY_URL=http://infinity:7997
# NATS only runs under the "events" profile; leave false unless you start it.
EVENTS_ENABLED=false
NATS_URL=nats://nats:4222

# --- Authentik / OIDC -----------------------------------------------------
AUTHENTIK_SECRET_KEY=<AUTHENTIK_SECRET_KEY>
AUTHENTIK_BOOTSTRAP_EMAIL=admin@iqbalai.com
AUTHENTIK_BOOTSTRAP_PASSWORD=<AUTHENTIK_ADMIN_PASSWORD>

# Server-side lookups stay on the private Docker network — they do not depend on
# public routing and keep working even if the public IP changes.
#
# The "iqbalai-frontend" path segment below is the Authentik APPLICATION SLUG, not a
# free label: getLogoutUrl() in frontend/src/lib/auth.ts hardcodes
# /application/o/iqbalai-frontend/end-session/. Create the application with exactly
# that slug, or logout 404s and the JWKS URL here points at nothing.
AUTHENTIK_API_URL=http://authentik-server:9000/api/v3
OIDC_JWKS_URL=http://authentik-server:9000/application/o/iqbalai-frontend/jwks/
# Browser-facing issuer (informational; the API does not verify the iss claim).
OIDC_ISSUER_URL=http://69.28.84.37:9000/application/o/iqbalai-frontend/
# The provider must be a PUBLIC client — the browser exchanges the auth code with no
# client_secret (OidcCallbackClient.tsx), so a confidential provider rejects it.
OIDC_CLIENT_ID=<AUTHENTIK_CLIENT_ID>
OIDC_CLIENT_SECRET=
# Filled in AFTER the Authentik bootstrap step of the runbook.
AUTHENTIK_API_TOKEN=

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<GROQ_API_KEY>
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_API_KEY=<OPENAI_API_KEY>
LLM_FALLBACK_MODEL=gpt-4o-mini

# --- API / CORS -----------------------------------------------------------
# No trailing slash — this string is compared against the browser's Origin header.
CORS_ALLOWED_ORIGINS=http://69.28.84.37
APP_URL=http://69.28.84.37
API_WORKERS=4
CELERY_CONCURRENCY=4

# --- Frontend (BUILD-TIME) ------------------------------------------------
# These are compiled into the browser bundle. After changing any of them you must
# run:  docker compose -f docker-compose.prod.yml --env-file .env.prod build frontend
NEXT_PUBLIC_API_URL=http://69.28.84.37/api/v1
NEXT_PUBLIC_WS_URL=ws://69.28.84.37
NEXT_PUBLIC_APP_URL=http://69.28.84.37
# Public host-nginx path; never expose Authentik's raw port to browsers.
NEXT_PUBLIC_AUTHENTIK_URL=https://<DOMAIN>/idp
# Replace with the client ID Authentik prints for the iqbalai provider.
NEXT_PUBLIC_AUTHENTIK_CLIENT_ID=<AUTHENTIK_CLIENT_ID>

# --- Email ----------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@iqbalai.com
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_TIMEOUT=30

# --- Observability (profile "observability") ------------------------------
GRAFANA_ADMIN_PASSWORD=<GRAFANA_PASSWORD>

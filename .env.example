# ============================================================
# IqbalAI v2 — Environment Variables
# Copy to .env and fill in values. NEVER commit .env
# ============================================================

# --- Postgres ---
POSTGRES_USER=iqbalai
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=iqbalai
DB_URL=postgresql+asyncpg://iqbalai:change_me_in_production@postgres:5432/iqbalai

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# --- NATS ---
NATS_URL=nats://nats:4222
# When false, API lifespan skips eager NATS connect (core-only compose boot — T-236).
EVENTS_ENABLED=false

# --- MinIO ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET_PDFS=pdfs
MINIO_BUCKET_AUDIO=audio
MINIO_BUCKET_ML_MODELS=ml-models
MINIO_BUCKET_EXPORTS=exports

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333

# --- Authentik ---
AUTHENTIK_SECRET_KEY=change_me_in_production_long_random_string
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost
AUTHENTIK_BOOTSTRAP_PASSWORD=change_me_in_production
# T-247: Authentik consumes this at FIRST init to mint an akadmin API token with
# this exact value. Set AUTHENTIK_API_TOKEN to the same value and both the API and
# the seed scripts can provision users immediately — no manual `ak shell` step.
# Dev/CI only; generate a fresh random value per environment (e.g. `openssl rand -hex 32`).
AUTHENTIK_BOOTSTRAP_TOKEN=change_me_dev_ci_only_random_string
# API token for user invite/password sync (Authentik Admin → Directory → Tokens).
AUTHENTIK_API_URL=http://authentik-server:9000/api/v3
# Set this equal to AUTHENTIK_BOOTSTRAP_TOKEN above for the zero-manual-step path.
# Alternatively (long-lived, rotate-on-demand), generate via:
# docker compose exec -T authentik-server ak shell < scripts/create_authentik_api_token.py
AUTHENTIK_API_TOKEN=

# --- OIDC (Authentik → FastAPI) ---
OIDC_ISSUER_URL=http://authentik-server:9000/application/o/iqbalai/
OIDC_CLIENT_ID=iqbalai-api
OIDC_CLIENT_SECRET=change_me_after_authentik_bootstrap
# T-247: redirect target Authentik sends the browser back to after login. ARCH
# §6.4 — the API owns the code exchange, so this is the API callback (reached by
# the browser). Consumed by the OIDC blueprint (infrastructure/authentik/blueprints).
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_JWKS_URL=http://authentik-server:9000/application/o/iqbalai/jwks/
# AUTHORIZE is opened in the *browser* → localhost:9000.
# TOKEN / REVOKE / JWKS / ISSUER are called by the *API container* → authentik-server.
# Using localhost for TOKEN from inside Docker makes the callback 500 (ConnectError).
OIDC_AUTHORIZE_URL=http://localhost:9000/application/o/authorize/
OIDC_TOKEN_URL=http://authentik-server:9000/application/o/token/
# RFC 7009 revoke endpoint, called at logout (T-246).
OIDC_REVOKE_URL=http://authentik-server:9000/application/o/revoke/

# --- Cookie session (T-244) ---
# Secure requires HTTPS. Local dev over http://localhost: set to false.
COOKIE_SECURE=true

# --- LLM ---
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_API_KEY=your_openai_key_here
LLM_FALLBACK_MODEL=gpt-4o-mini

# Task-specific model overrides (optional — falls back to LLM_MODEL if not set)
LECTURE_GEN_MODEL=
CHATBOT_MODEL=
STUDENT_QA_MODEL=
VA_MODEL=
SCORING_MODEL=

# --- Embeddings ---
# Prod: EMBEDDING_PROVIDER=infinity + Infinity container (BGE-M3, ~2 GB RAM)
# Dev:  EMBEDDING_PROVIDER=local embeds inside Celery via fastembed/ONNX (~150 MB, no Infinity)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_VECTOR_DIM=0
INFINITY_URL=http://infinity:7997

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Comma-separated browser origins for API CORS (add LAN IP if not using localhost)
# e.g. http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend auth (T-240, audit B1) ---
# REQUIRED in production — a prod build fails loudly if any of these three are
# unset (frontend/src/lib/env-guard.ts). Dev falls back to the localhost value
# shown below with a console warning.
# Public Authentik URL: MUST be the public /idp reverse-proxy path in
# production (ARCH §15.11), never a raw port, e.g. https://iqbalai.pk/idp.
# localhost:9000 is fine for local dev only.
NEXT_PUBLIC_AUTHENTIK_URL=http://localhost:9000
NEXT_PUBLIC_AUTHENTIK_CLIENT_ID=iqbalai-frontend
# Public app URL — used to build the OIDC redirect_uri.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin

# --- Notifications (optional — gracefully degraded if absent) ---
# EMAIL_PROVIDER=log | smtp
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@iqbalai.pk
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=30
SMS_PROVIDER=jazz
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=IqbalAI
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# --- Web search (SearXNG) ---
WEBSEARCH_URL=http://searxng:8080
